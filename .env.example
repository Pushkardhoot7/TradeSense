# TradeSense V2 Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# Market Data Provider
# Options: yfinance (free, historical only), zerodha, upstox, alphavantage, twelvedata
MARKET_DATA_PROVIDER=yfinance

# API Key for live/premium data providers (not needed for yfinance)
MARKET_DATA_API_KEY=

# Broker API credentials (for live quotes via Zerodha Kite, etc.)
BROKER_API_KEY=
BROKER_ACCESS_TOKEN=

# Application settings
APP_ENV=development
DATABASE_URL=sqlite:///./data/tradesense.db
DEBUG=true
